<?xml version="1.0" encoding="utf-8"?>

<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:name=".notifications.OcasionApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Ocasion_mobil_v2"
        android:networkSecurityConfig="@xml/network_security_config">

        <activity
            android:name=".ui.login.LoginActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Ocasion_mobil_v2">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <activity android:name=".ui.login.CompleteGoogleRegisterActivity" android:exported="false" />
        <activity android:name=".ui.legal.DocumentoLegalActivity" android:exported="false" />
        <activity android:name=".ui.cliente.pagos.MisReservacionesActivity" android:exported="false" />
        <activity android:name=".ui.propietario.reservaciones.CheckInActivity" android:exported="false" />
        <activity
            android:name=".ui.login.VerifyCodeActivity"
            android:exported="false" />

        <activity
            android:name=".ui.login.RegisterActivity"
            android:exported="false" />

        <activity
            android:name=".ui.login.ForgotPasswordActivity"
            android:exported="false" />

        <activity
            android:name=".ui.login.NewPasswordActivity"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:scheme="http"
                    android:host="localhost"
                    android:port="4200"
                    android:pathPrefix="/cambiar-password" />
            </intent-filter>

        </activity>

        <activity
            android:name=".MainActivity"
            android:exported="true" />

        <activity
            android:name=".ui.cliente.ClientPrincipalMenu"
            android:exported="false" />

        <activity
            android:name=".ui.cliente.DetalleSalonActivity"
            android:exported="false" />

        <activity
            android:name=".ui.propietario.OwnerHomeActivity"
            android:exported="false" />

        <activity
            android:name=".ui.propietario.SalonFormActivity"
            android:exported="false" />

        <activity
            android:name=".ui.propietario.MisSalonesActivity"
            android:exported="false" />

        <activity
            android:name=".ui.propietario.catalogoSalon.CatalogoSalonActivity"
            android:exported="false" />

        <activity
            android:name=".ui.propietario.ConfirmacionSalonActivity"
            android:exported="false" />

        <activity
            android:name=".ui.propietario.PerfilPropietarioActivity"
            android:exported="false" />

        <activity
            android:name=".ui.propietario.SalonUbicacionActivity"
            android:exported="false" />

        <activity
            android:name=".ui.propietario.SalonDisponibilidadActivity"
            android:exported="false" />

        <activity
            android:name=".ui.propietario.SalonPublicacionActivity"
            android:exported="false" />

        <activity
            android:name=".ui.propietario.DocumentosSalonActivity"
            android:exported="false" />

        <activity
            android:name=".ui.propietario.reservaciones.ReservacionesActivity"
            android:exported="false" />

        <activity
            android:name=".ui.propietario.reservaciones.ReservaActivity"
            android:exported="false" />

        <activity
            android:name=".ui.propietario.reservaciones.PanelPropietarioActivity"
            android:exported="false" />

        <activity
            android:name=".ui.propietario.reservaciones.CotizarPropietarioActivity"
            android:exported="false" />

        <service
            android:name=".notifications.OcasionMessagingService"
            android:exported="false">

            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>

        </service>

        <provider
            android:name=".ui.propietario.reservaciones.ReservasPdfProvider"
            android:authorities="${applicationId}.reservas.pdf"
            android:exported="false"
            android:grantUriPermissions="true">

            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/reservas_pdf_paths" />

        </provider>

    </application>

</manifest>
