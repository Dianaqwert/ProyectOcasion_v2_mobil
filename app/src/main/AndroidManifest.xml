<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />
    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Ocasion_mobil_v2"
        android:networkSecurityConfig="@xml/network_security_config">

        <activity
            android:name=".ui.login.LoginActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Ocasion_mobil_v2">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>
        <activity
            android:name=".ui.login.VerifyCodeActivity"
            android:exported="false" />
        <activity
            android:name=".ui.login.RegisterActivity"
            android:exported="false" />
        <activity
            android:name=".ui.cliente.ClientPrincipalMenu"
            android:exported="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true" />

        <activity
            android:name=".ui.login.ForgotPasswordActivity"
            android:exported="false" />

        <!-- PROPIETARIO -->
        <activity
            android:name=".ui.propietario.OwnerHomeActivity"
            android:exported="false" />

        <activity
            android:name=".ui.propietario.SalonFormActivity"
            android:exported="false" />

        <activity
            android:name=".ui.propietario.MisSalonesActivity"
            android:exported="false" />
        <!--
        <activity
            android:name=".ui.propietarios.ReservasActivity"
            android:exported="false" /> -->

        <activity
            android:name=".ui.propietario.PerfilPropietarioActivity"
            android:exported="false" />

        <activity
            android:name=".ui.propietario.SalonUbicacionActivity"
            android:exported="false" />

        <activity
            android:name=".ui.propietario.SalonDisponibilidadActivity"
            android:exported="false" />

        <activity
            android:name=".ui.propietario.SalonPublicacionActivity"
            android:exported="false" />

        <activity
            android:name=".ui.login.NewPasswordActivity"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <!-- Cambiamos el pathPrefix por el correcto -->
                <data
                    android:scheme="http"
                    android:host="localhost"
                    android:port="4200"
                    android:pathPrefix="/cambiar-password" />
            </intent-filter>
        </activity>

    </application>

</manifest>