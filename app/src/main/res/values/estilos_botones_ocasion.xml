<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="BotonOcasionPrincipal"
        parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/boton_principal_fondo</item>
        <item name="android:textColor">@color/boton_texto</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">48dp</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="elevation">0dp</item>
        <item name="rippleColor">#242E2A1F</item>
    </style>

    <style name="BotonOcasionSalida" parent="BotonOcasionPrincipal">
        <item name="backgroundTint">@color/naranja_primario</item>
        <item name="android:textColor">@color/texto_principal</item>
    </style>

    <style name="BotonOcasionSecundario"
        parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="backgroundTint">@color/blanco</item>
        <item name="strokeColor">@color/boton_secundario_borde</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:textColor">@color/boton_texto</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">48dp</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="elevation">0dp</item>
        <item name="rippleColor">#24F57328</item>
    </style>

</resources>
