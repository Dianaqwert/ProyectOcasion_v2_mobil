<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="BotonOcasionPrincipal"
        parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/verde_primario</item>
        <item name="android:textColor">@color/blanco</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">48dp</item>
        <item name="cornerRadius">22dp</item>
    </style>

    <style name="BotonOcasionSalida" parent="BotonOcasionPrincipal">
        <item name="backgroundTint">@color/naranja_primario</item>
        <item name="android:textColor">@color/texto_principal</item>
    </style>

    <style name="BotonOcasionSecundario"
        parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="backgroundTint">@color/blanco</item>
        <item name="strokeColor">@color/verde_primario</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:textColor">@color/verde_primario</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">48dp</item>
        <item name="cornerRadius">22dp</item>
    </style>

</resources>