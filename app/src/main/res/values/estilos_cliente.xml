<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="ClienteSeccion" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">18dp</item>
        <item name="android:background">@drawable/bg_owner_card</item>
    </style>
    <style name="ClienteTitulo" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">19sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/texto_principal</item>
    </style>
    <style name="ClienteTexto" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:lineSpacingExtra">3dp</item>
        <item name="android:textColor">@color/texto_secundario</item>
    </style>
    <style name="ClienteEtiqueta" parent="ClienteTexto">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:background">@drawable/bg_badge</item>
        <item name="android:paddingHorizontal">10dp</item>
        <item name="android:paddingVertical">6dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/texto_principal</item>
    </style>
</resources>
