<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootReservaciones"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_general">

    <!-- ENCABEZADO -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        android:background="@color/header_footer_light">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVolverReservas"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:gravity="center"
            android:text="‹"
            android:textSize="34sp"
            android:textAllCaps="false"
            android:textColor="@color/texto_principal"
            android:contentDescription="Volver a la pantalla anterior"
            app:backgroundTint="@android:color/transparent"
            app:cornerRadius="24dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="5dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Reservaciones"
                android:textColor="@color/texto_principal"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Gestiona las solicitudes y eventos de tus salones."
                android:textColor="@color/texto_secundario"
                android:textSize="12sp" />

        </LinearLayout>

    </LinearLayout>

    <!-- ACCESOS DE GESTIÓN -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="18dp"
        android:layout_marginTop="18dp"
        android:layout_marginBottom="12dp"
        android:orientation="vertical"
        android:padding="18dp"
        android:background="@drawable/bg_owner_card">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Organiza tus eventos"
            android:textColor="@color/texto_principal"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Prepara cotizaciones o consulta tu historial por mes."
            android:textColor="@color/texto_secundario"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:baselineAligned="false">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNuevasT7"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="5dp"
                android:minWidth="0dp"
                android:minHeight="52dp"
                android:paddingHorizontal="10dp"
                android:paddingVertical="12dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Solicitudes nuevas"
                android:textAllCaps="false"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/blanco"
                app:backgroundTint="@color/naranja_primario"
                app:cornerRadius="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMensualT13"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="5dp"
                android:minWidth="0dp"
                android:minHeight="52dp"
                android:paddingHorizontal="10dp"
                android:paddingVertical="12dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Panel mensual"
                android:textAllCaps="false"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/verde_primario"
                app:backgroundTint="@color/bg_general"
                app:strokeColor="@color/verde_primario"
                app:strokeWidth="1dp"
                app:cornerRadius="12dp" />

        </LinearLayout>

    </LinearLayout>

    <!-- BANDEJA EXISTENTE -->
    <!-- El fragmento conserva su lista, carga, errores y acciones. -->

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/inboxContainer"
        android:name="com.example.ocasion_mobil_v2.ui.propietario.reservaciones.ReservacionesInboxFragment"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- MENÚ INFERIOR -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@drawable/bg_bottom_menu"
        android:elevation="10dp">

        <include
            layout="@layout/bottom_nav_owner"
            android:layout_width="match_parent"
            android:layout_height="72dp" />

    </LinearLayout>

</LinearLayout>