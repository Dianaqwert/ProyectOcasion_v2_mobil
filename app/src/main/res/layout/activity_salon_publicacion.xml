<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_general">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <!-- ENCABEZADO -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/btnBackPublicacion"
                    android:layout_width="45dp"
                    android:layout_height="45dp"
                    android:gravity="center"
                    android:text="‹"
                    android:textColor="@color/texto_principal"
                    android:textSize="34sp"
                    android:clickable="true"
                    android:focusable="true" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="5dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Mi publicación"
                        android:textColor="@color/texto_principal"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Así podrán ver tu salón los clientes."
                        android:textColor="@color/texto_secundario"
                        android:textSize="12sp" />

                </LinearLayout>

            </LinearLayout>


            <!-- GALERÍA -->

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:layout_marginTop="20dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="3dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageView
                        android:id="@+id/imgSalonPublicacion"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@color/header_footer_light"
                        android:contentDescription="Imagen del salón"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_launcher_background" />

                    <TextView
                        android:id="@+id/tvContadorImagenes"
                        android:layout_width="wrap_content"
                        android:layout_height="35dp"
                        android:layout_gravity="bottom|end"
                        android:layout_margin="12dp"
                        android:background="@drawable/bg_button_primary"
                        android:gravity="center"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:text="1 / 5"
                        android:textColor="@color/blanco"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                </FrameLayout>

            </com.google.android.material.card.MaterialCardView>


            <!-- INFORMACIÓN -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="18dp">


                <!-- NOMBRE -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Nombre del salón"
                            android:textColor="@color/texto_secundario"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/tvNombrePublicacion"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="Salón Jardín"
                            android:textColor="@color/texto_principal"
                            android:textSize="21sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/btnEditarNombre"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:gravity="center"
                        android:text="✎"
                        android:textSize="20sp"
                        android:textColor="@color/verde_primario"
                        android:clickable="true"
                        android:focusable="true" />

                </LinearLayout>


                <!-- CAPACIDAD -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Capacidad"
                            android:textColor="@color/texto_secundario"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/tvCapacidadPublicacion"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="150 personas"
                            android:textColor="@color/texto_principal"
                            android:textSize="15sp" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/btnEditarCapacidad"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:gravity="center"
                        android:text="✎"
                        android:textSize="20sp"
                        android:textColor="@color/verde_primario"
                        android:clickable="true"
                        android:focusable="true" />

                </LinearLayout>


                <!-- PRECIO -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Precio por hora"
                            android:textColor="@color/texto_secundario"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/tvPrecioPublicacion"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="$850 / hora"
                            android:textColor="@color/verde_primario"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/btnEditarPrecio"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:gravity="center"
                        android:text="✎"
                        android:textSize="20sp"
                        android:textColor="@color/verde_primario"
                        android:clickable="true"
                        android:focusable="true" />

                </LinearLayout>


                <!-- DESCRIPCIÓN -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Descripción"
                            android:textColor="@color/texto_secundario"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/tvDescripcionPublicacion"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="Espacio ideal para celebraciones y eventos."
                            android:textColor="@color/texto_principal"
                            android:textSize="14sp"
                            android:lineSpacingExtra="2dp" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/btnEditarDescripcion"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:gravity="center"
                        android:text="✎"
                        android:textSize="20sp"
                        android:textColor="@color/verde_primario"
                        android:clickable="true"
                        android:focusable="true" />

                </LinearLayout>

            </LinearLayout>


            <!-- UBICACIÓN -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Ubicación"
                        android:textColor="@color/texto_principal"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnEditarUbicacion"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:gravity="center"
                        android:text="✎"
                        android:textSize="20sp"
                        android:textColor="@color/verde_primario"
                        android:clickable="true"
                        android:focusable="true" />

                </LinearLayout>

                <TextView
                    android:id="@+id/tvDireccionPublicacion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Av. Universidad 123&#10;Fraccionamiento Centro&#10;Aguascalientes, CP 20000"
                    android:textColor="@color/texto_secundario"
                    android:textSize="13sp"
                    android:lineSpacingExtra="3dp" />


                <!-- MAPA -->

                <FrameLayout
                    android:id="@+id/mapContainer"
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    android:layout_marginTop="15dp"
                    android:background="@drawable/bg_map_placeholder">

                    <TextView
                        android:id="@+id/tvMapaPlaceholder"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="📍\nMapa de Google Maps"
                        android:textColor="@color/texto_secundario"
                        android:textSize="15sp" />

                </FrameLayout>

            </LinearLayout>


            <!-- ACCIONES -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDisponibilidad"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="18dp"
                android:text="Gestionar disponibilidad"
                android:textAllCaps="false"
                android:textColor="@color/texto_principal"
                android:backgroundTint="@color/header_footer_light"
                android:background="@drawable/bg_button_secondary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEditarImagenes"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:text="Editar imágenes"
                android:textAllCaps="false"
                android:textColor="@color/texto_principal"
                android:backgroundTint="@color/header_footer_light"
                android:background="@drawable/bg_button_secondary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPublicarSalon"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="18dp"
                android:text="Publicar salón"
                android:textAllCaps="false"
                android:textColor="@color/blanco"
                android:textSize="15sp"
                android:textStyle="bold"
                android:backgroundTint="@color/naranja_primario"
                android:background="@drawable/bg_button_secondary" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="30dp" />


        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- MENÚ INFERIOR -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@drawable/bg_bottom_menu"
        android:elevation="10dp">

        <include
            layout="@layout/bottom_nav_owner"
            android:layout_width="match_parent"
            android:layout_height="72dp" />
    </LinearLayout>

</LinearLayout>