<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    android:clickable="true"
    android:focusable="true"
    app:cardCornerRadius="22dp"
    app:cardElevation="1dp"
    app:cardBackgroundColor="@color/blanco"
    app:strokeWidth="1dp"
    app:strokeColor="@color/borde_input">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="190dp"
            android:background="@color/header_footer_light">
            <ImageView
                android:id="@+id/ivSalon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:contentDescription="Fotografía del salón"
                tools:srcCompat="@tools:sample/backgrounds/scenic" />
            <TextView
                android:id="@+id/tvCapacidad"
                style="@style/ClienteEtiqueta"
                android:layout_gravity="top|end"
                android:layout_margin="12dp"
                android:layout_marginTop="12dp"
                android:textStyle="bold"
                tools:text="250 personas" />
        </FrameLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">
            <TextView
                android:id="@+id/tvNombreRecinto"
                style="@style/ClienteTitulo"
                android:maxLines="2"
                android:ellipsize="end"
                tools:text="Hacienda Los Laureles" />
            <TextView
                android:id="@+id/tvVerificacionSalon"
                style="@style/ClienteEtiqueta"
                android:textStyle="bold"
                tools:text="Verificado por Ocasion" />
            <TextView
                android:id="@+id/tvCiudad"
                style="@style/ClienteTexto"
                android:layout_marginTop="4dp"
                tools:text="Aguascalientes" />
            <TextView
                android:id="@+id/tvPrecioHora"
                style="@style/ClienteTitulo"
                android:layout_marginTop="12dp"
                android:textColor="@color/verde_primario"
                tools:text="$1,850.00 / hr" />
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/containerServicios"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp">
                <TextView
                    android:id="@+id/tvServicio1"
                    style="@style/ClienteEtiqueta"
                    android:layout_marginEnd="6dp"
                    android:visibility="gone"
                    tools:text="Banquete"
                    tools:visibility="visible" />
                <TextView
                    android:id="@+id/tvServicio2"
                    style="@style/ClienteEtiqueta"
                    android:visibility="gone"
                    tools:text="Sonido"
                    tools:visibility="visible" />
            </com.google.android.material.chip.ChipGroup>
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:background="@color/borde_input" />
            <TextView
                style="@style/ClienteTexto"
                android:text="Ver fotos, servicios y disponibilidad  →"
                android:textColor="@color/verde_primario"
                android:textStyle="bold"
                android:layout_marginTop="12dp" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
