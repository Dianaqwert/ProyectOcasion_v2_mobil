<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/bg_general" android:orientation="vertical">
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical" android:background="@color/header_footer_light" android:padding="16dp">
<com.google.android.material.button.MaterialButton
    android:id="@+id/btnVolverDisponibilidad"
    style="@style/BotonOcasionSecundario"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="Volver"  />
<TextView android:id="@+id/tituloDisponibilidad"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:text="Disponibilidad" android:textColor="@color/texto_principal"
    android:textSize="24sp" android:textStyle="bold" />
<TextView
    android:id="@+id/identificadorDisponibilidad"
    style="@style/ClienteTexto"
    android:layout_marginTop="4dp"
    android:textColor="@color/texto_principal"
    android:visibility="gone" />
</LinearLayout>
<ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical" android:padding="16dp">
<ProgressBar android:id="@+id/progresoDisponibilidad"
    android:layout_width="wrap_content" android:layout_height="wrap_content"
    android:layout_gravity="center_horizontal" android:visibility="gone" />
<TextView android:id="@+id/errorDisponibilidad"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:accessibilityLiveRegion="polite" android:textColor="@color/rojo_error"
    android:visibility="gone" />
<com.google.android.material.button.MaterialButton
    android:id="@+id/btnRecargarDisponibilidad"
    style="@style/BotonOcasionSecundario"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="Reintentar" android:visibility="gone" />
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical" android:id="@+id/formularioDisponibilidad">
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical" android:layout_marginTop="16dp" android:padding="16dp" android:background="@drawable/bg_owner_card">
<TextView
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="Horario habitual"
    android:textColor="@color/texto_principal"
    android:textSize="20sp" android:textStyle="bold" />
<TextView
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="Se repite todos los días desde la fecha indicada."
    android:textColor="@color/texto_secundario"
    android:textSize="14sp"  />
<com.google.android.material.button.MaterialButton
    android:id="@+id/btnFechaDesde"
    style="@style/BotonOcasionSecundario"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="Disponible desde"  />
<com.google.android.material.button.MaterialButton
    android:id="@+id/btnApertura"
    style="@style/BotonOcasionSecundario"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="Apertura"  />
<com.google.android.material.button.MaterialButton
    android:id="@+id/btnCierre"
    style="@style/BotonOcasionSecundario"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="Cierre"  />
<TextView
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="Para atender todo el día, usa de 00:00 a 23:59."
    android:textColor="@color/texto_secundario"
    android:textSize="14sp"  />
<com.google.android.material.button.MaterialButton
    android:id="@+id/btnGuardarHorario"
    style="@style/BotonOcasionPrincipal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="Guardar horario" android:layout_marginTop="8dp" />
</LinearLayout>
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical" android:layout_marginTop="16dp" android:padding="16dp" android:background="@drawable/bg_owner_card">
<TextView
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="Bloqueos"
    android:textColor="@color/texto_principal"
    android:textSize="20sp" android:textStyle="bold" />
<TextView
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="Aparta una fecha y un intervalo en el que el salón no estará disponible."
    android:textColor="@color/texto_secundario"
    android:textSize="14sp"  />
<com.google.android.material.button.MaterialButton
    android:id="@+id/btnFechaBloqueo"
    style="@style/BotonOcasionSecundario"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="Fecha del bloqueo"  />
<com.google.android.material.button.MaterialButton
    android:id="@+id/btnInicioBloqueo"
    style="@style/BotonOcasionSecundario"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="Hora de inicio"  />
<com.google.android.material.button.MaterialButton
    android:id="@+id/btnFinBloqueo"
    style="@style/BotonOcasionSecundario"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="Hora de fin"  />
<com.google.android.material.textfield.TextInputLayout
    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:hint="Observaciones (opcional)">
    <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/notaBloqueo"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:inputType="textCapSentences|textMultiLine" android:maxLength="500" />
</com.google.android.material.textfield.TextInputLayout>
<com.google.android.material.button.MaterialButton
    android:id="@+id/btnAgregarBloqueo"
    style="@style/BotonOcasionSecundario"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="Agregar bloqueo" android:layout_marginTop="8dp" />
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical" android:id="@+id/listaBloqueos">

</LinearLayout>
</LinearLayout>
<include
    android:id="@+id/panelConfirmacionLegal"
    layout="@layout/tarjeta_confirmacion_legal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="16dp" />

<com.google.android.material.button.MaterialButton
    android:id="@+id/btnContinuarDisponibilidad"
    style="@style/BotonOcasionPrincipal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="Guardar y continuar" android:layout_marginTop="18dp" />
</LinearLayout>
</LinearLayout>
</ScrollView>
</LinearLayout>
