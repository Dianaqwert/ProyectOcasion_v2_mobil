<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_general">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <!-- ENCABEZADO -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/btnBackDisponibilidad"
                    android:layout_width="45dp"
                    android:layout_height="45dp"
                    android:gravity="center"
                    android:text="‹"
                    android:textColor="@color/texto_principal"
                    android:textSize="34sp"
                    android:clickable="true"
                    android:focusable="true" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="5dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Disponibilidad"
                        android:textColor="@color/texto_principal"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Administra las fechas y horarios no disponibles."
                        android:textColor="@color/texto_secundario"
                        android:textSize="12sp" />

                </LinearLayout>

            </LinearLayout>


            <!-- CALENDARIO -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Selecciona una fecha"
                    android:textColor="@color/texto_principal"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <CalendarView
                    android:id="@+id/calendarDisponibilidad"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:firstDayOfWeek="2" />

            </LinearLayout>


            <!-- HORARIO -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Horario a bloquear"
                    android:textColor="@color/texto_principal"
                    android:textSize="17sp"
                    android:textStyle="bold" />


                <!-- FECHA -->

                <TextView
                    android:id="@+id/tvFechaSeleccionada"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Fecha: Selecciona una fecha"
                    android:textColor="@color/texto_secundario"
                    android:textSize="13sp" />


                <!-- HORAS -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnHoraInicio"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:text="Hora inicio"
                        android:textAllCaps="false"
                        android:textColor="@color/texto_principal"
                        android:backgroundTint="@color/header_footer_light"
                        android:background="@drawable/bg_button_secondary" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnHoraFin"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:text="Hora final"
                        android:textAllCaps="false"
                        android:textColor="@color/texto_principal"
                        android:backgroundTint="@color/header_footer_light"
                        android:background="@drawable/bg_button_secondary" />

                </LinearLayout>


                <!-- OBSERVACIONES -->

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="Observaciones *"
                    android:textColor="@color/texto_principal"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etObservaciones"
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_edittext"
                    android:gravity="top|start"
                    android:hint="Ej. Mantenimiento, evento privado..."
                    android:inputType="textCapSentences|textMultiLine"
                    android:padding="14dp"
                    android:textColor="@color/texto_principal"
                    android:textColorHint="@color/texto_secundario" />

                <TextView
                    android:id="@+id/tvErrorDisponibilidad"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:textColor="@color/rojo_error"
                    android:textSize="11sp"
                    android:visibility="gone" />

            </LinearLayout>


            <!-- BLOQUEAR -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBloquearHorario"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="18dp"
                android:text="Bloquear horario"
                android:textAllCaps="false"
                android:textColor="@color/blanco"
                android:textSize="15sp"
                android:textStyle="bold"
                android:backgroundTint="@color/rojo_error"
                android:background="@drawable/bg_button_secondary" />


            <!-- BLOQUEOS -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:text="Horarios bloqueados"
                android:textColor="@color/texto_principal"
                android:textSize="18sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/containerBloqueos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="30dp" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- MENÚ INFERIOR -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@drawable/bg_bottom_menu"
        android:elevation="10dp">

        <include
            layout="@layout/bottom_nav_owner"
            android:layout_width="match_parent"
            android:layout_height="72dp" />
    </LinearLayout>


</LinearLayout>