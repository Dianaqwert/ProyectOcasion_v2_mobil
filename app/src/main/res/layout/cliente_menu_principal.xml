<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="@color/bg_general">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="16dp"
        android:background="@drawable/bg_inicio_cliente">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <include layout="@layout/logo_barra_propietario" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMisReservacionesCliente"
                style="@style/BotonOcasionSecundario"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mis reservaciones"
                android:textSize="13sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCerrarSesionCliente"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="48dp"
                android:minHeight="48dp"
                android:text="Salir"
                android:textAllCaps="false"
                android:textColor="@color/texto_principal"
                android:contentDescription="Cerrar sesión" />
        </LinearLayout>

        <TextView
            style="@style/ClienteTitulo"
            android:layout_marginTop="8dp"
            android:accessibilityHeading="true"
            android:text="Encuentra tu salón ideal"
            android:textSize="23sp" />

        <TextView
            style="@style/ClienteTexto"
            android:layout_marginTop="3dp"
            android:text="Compara espacios, servicios y precios."
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <androidx.appcompat.widget.SearchView
                android:id="@+id/searchView"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:background="@drawable/bg_buscador_cliente"
                app:iconifiedByDefault="false"
                app:queryBackground="@android:color/transparent"
                app:queryHint="Nombre, ciudad o CP" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFiltros"
                style="@style/BotonOcasionPrincipal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:minWidth="0dp"
                android:text="Filtros" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">
            <TextView
                android:id="@+id/tvEstadoBusqueda"
                style="@style/ClienteTexto"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:accessibilityLiveRegion="polite" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnActualizarSalones"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Actualizar"
                android:textColor="@color/boton_texto" />
        </LinearLayout>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLimpiarBusqueda"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Limpiar búsqueda y filtros"
            android:textColor="@color/boton_texto"
            android:visibility="gone" />
    </LinearLayout>
    <!-- El RecyclerView administra el desplazamiento y recicla las tarjetas. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvSalonesCliente"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingHorizontal="16dp"
            android:paddingTop="4dp"
            android:paddingBottom="16dp"
            android:clipToPadding="false"
            android:scrollbars="vertical" />
        <ProgressBar
            android:id="@+id/progressSalones"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:indeterminateTint="@color/verde_primario"
            android:visibility="gone" />
        <LinearLayout
            android:id="@+id/emptyStateSalones"
            style="@style/ClienteSeccion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="20dp"
            android:layout_gravity="center"
            android:gravity="center"
            android:visibility="gone">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⌕"
                android:textSize="48sp"
                android:textColor="@color/naranja_primario"
                android:importantForAccessibility="no" />
            <TextView
                android:id="@+id/tvEmptySalones"
                style="@style/ClienteTexto"
                android:gravity="center" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReintentarSalones"
                style="@style/BotonOcasionPrincipal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Reintentar"
                android:visibility="gone" />
        </LinearLayout>
    </FrameLayout>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnMasSalones"
        style="@style/BotonOcasionSecundario"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="8dp"
        android:text="Cargar más salones"
        android:visibility="gone" />
</LinearLayout>
