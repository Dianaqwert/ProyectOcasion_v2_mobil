<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/bg_general" android:fitsSystemWindows="true">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:padding="16dp" android:gravity="center_vertical">
        <androidx.appcompat.widget.SearchView android:id="@+id/searchView"
            android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"
            android:background="@drawable/bg_edittext"
            app:queryHint="Nombre, ciudad o código postal" app:iconifiedByDefault="false" />
        <ImageButton android:id="@+id/btnFiltros" android:layout_width="48dp"
            android:layout_height="48dp" android:layout_marginStart="8dp"
            android:background="@drawable/bg_edittext" android:src="@android:drawable/ic_menu_preferences"
            android:contentDescription="Abrir filtros" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingBottom="16dp">
            <TextView android:id="@+id/tvTituloSalones" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:paddingHorizontal="16dp"
                android:text="Encuentra tu salón ideal" android:textColor="@color/texto_principal"
                android:textSize="21sp" android:textStyle="bold" />
            <TextView android:id="@+id/tvSubtituloSalones" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:paddingHorizontal="16dp"
                android:layout_marginTop="4dp" android:text="Explora espacios para celebrar tus momentos especiales"
                android:textColor="@color/texto_secundario" android:textSize="13sp" />
            <TextView android:id="@+id/tvEstadoBusqueda" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:paddingHorizontal="16dp"
                android:layout_marginTop="12dp" android:textColor="@color/texto_secundario"
                android:accessibilityLiveRegion="polite" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnLimpiarBusqueda"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="12dp" android:text="Limpiar búsqueda y filtros"
                android:visibility="gone" />

            <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:minHeight="360dp">
                <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvSalonesHorizontales"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:minHeight="350dp" android:paddingHorizontal="16dp"
                    android:clipToPadding="false" android:overScrollMode="never" />
                <ProgressBar android:id="@+id/progressSalones" android:layout_width="40dp"
                    android:layout_height="40dp" android:layout_gravity="center" android:visibility="gone" />
                <LinearLayout android:id="@+id/emptyStateSalones" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_gravity="center"
                    android:layout_marginHorizontal="24dp" android:gravity="center"
                    android:orientation="vertical" android:padding="20dp" android:visibility="gone">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="⌕" android:textColor="@color/naranja_primario" android:textSize="48sp"
                        android:importantForAccessibility="no" />
                    <TextView android:id="@+id/tvEmptySalones" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:gravity="center"
                        android:textColor="@color/texto_secundario" android:textSize="15sp" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnReintentarSalones"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="12dp" android:text="Reintentar" android:visibility="gone"
                        app:backgroundTint="@color/naranja_primario" />
                </LinearLayout>
            </FrameLayout>
            <com.google.android.material.button.MaterialButton android:id="@+id/btnMasSalones"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_gravity="center" android:text="Cargar más salones" android:visibility="gone"
                app:backgroundTint="@color/verde_primario" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingHorizontal="16dp" android:paddingVertical="8dp" android:gravity="center">
        <com.google.android.material.button.MaterialButton android:id="@+id/btnActualizarSalones"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="Actualizar" app:backgroundTint="@color/verde_primario" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btnCerrarSesionCliente"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="Cerrar sesión" />
    </LinearLayout>
</LinearLayout>
