<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/blanco"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/header_footer_light"
        android:padding="20dp"
        android:text="Servicios del evento"
        android:textColor="@color/texto_principal"
        android:textSize="22sp"
        android:textStyle="bold" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="PASO 2 · SERVICIOS"
                android:textColor="@color/verde_primario"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvResumenReservaServicios"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_owner_card"
                android:padding="18dp"
                android:textColor="@color/texto_principal"
                android:textSize="18sp"
                tools:text="100 invitados&#10;25 nov 2026 — 26 nov 2026" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="La selección de servicios aún no está disponible."
                android:textColor="@color/texto_secundario"
                android:textSize="15sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEditarFechasReserva"
                style="@style/BotonOcasionSecundario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Editar fechas e invitados" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>