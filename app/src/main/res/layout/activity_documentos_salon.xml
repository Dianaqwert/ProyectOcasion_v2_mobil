<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootDocumentosSalon"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_general"
    android:orientation="vertical">

    <!-- ENCABEZADO -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/header_footer_light"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp">

        <ImageButton
            android:id="@+id/btnVolverDocumentos"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_icon_circle"
            android:contentDescription="Volver"
            android:padding="12dp"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="@color/texto_principal" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PROPIETARIO"
                android:textColor="@color/verde_primario"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Documentación del salón"
                android:textColor="@color/texto_principal"
                android:textSize="21sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- CONTENIDO CON DESPLAZAMIENTO -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvNombreDocumentos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Expediente del salón"
                android:textColor="@color/texto_principal"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Identificación y fotos: JPG o PNG. Propiedad, domicilio y Vo.Bo.: PDF, JPG o PNG. Máximo 5 MB por archivo. Para corregir un rechazo, selecciona de nuevo el expediente completo."
                android:textColor="@color/texto_secundario"
                android:textSize="14sp" />

            <!-- Solo se mostrará si el administrador devuelve observaciones -->
            <TextView
                android:id="@+id/tvObservacionesDocumentos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_owner_card"
                android:padding="12dp"
                android:textColor="@color/rojo_error"
                android:textSize="14sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvEstadoDocumentos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:accessibilityLiveRegion="polite"
                android:textColor="@color/texto_principal"
                android:textSize="16sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnActualizarDocumentos"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Actualizar estado"
                android:textAllCaps="false"
                app:cornerRadius="12dp" />

            <!-- La actividad genera los apartados según TipoDocumento. -->
            <LinearLayout
                android:id="@+id/containerDocumentos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="El salón se publica antes de solicitar la verificación. Podrá aparecer en las búsquedas mientras se revisan sus documentos. Si la carga falla, puedes reintentar desde Mis salones."
                android:textColor="@color/texto_secundario"
                android:textSize="14sp" />

            <ProgressBar
                android:id="@+id/progresoDocumentos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvErrorDocumentos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:accessibilityLiveRegion="polite"
                android:textColor="@color/rojo_error"
                android:visibility="gone" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- PIE DE PANTALLA -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/header_footer_light"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp">

        <TextView
            android:id="@+id/tvTotalDocumentos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite"
            android:gravity="center"
            android:text="0 archivos · 0 MB / 99 MB"
            android:textColor="@color/texto_secundario"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEnviarDocumentos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:enabled="false"
            android:minHeight="48dp"
            android:text="Enviar a revisión"
            android:textAllCaps="false"
            app:cornerRadius="12dp" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMisSalonesDocumentos"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Volver a Mis salones"
            android:textAllCaps="false"
            app:cornerRadius="12dp" />
    </LinearLayout>

</LinearLayout>