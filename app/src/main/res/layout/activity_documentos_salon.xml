<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootDocumentosSalon"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_general"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- ENCABEZADO -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/header_footer_light"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp">

        <ImageButton
            android:id="@+id/btnVolverDocumentos"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_icon_circle"
            android:contentDescription="Volver"
            android:padding="12dp"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="@color/texto_principal" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PROPIETARIO"
                android:textColor="@color/verde_primario"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Documentación del salón"
                android:textColor="@color/texto_principal"
                android:textSize="21sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- CONTENIDO CON DESPLAZAMIENTO -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvNombreSalonDocumentos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Expediente del salón"
                android:textColor="@color/texto_principal"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Agrega un archivo por apartado y revisa que se pueda leer antes de enviarlo. Tamaño máximo: 5 MB por archivo."
                android:textColor="@color/texto_secundario"
                android:textSize="14sp" />

            <!-- Solo se mostrará si el administrador devuelve observaciones -->
            <TextView
                android:id="@+id/tvObservacionesDocumentos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_owner_card"
                android:padding="12dp"
                android:textColor="@color/rojo_error"
                android:textSize="14sp"
                android:visibility="gone" />

            <!-- 1. COMPROBANTE -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="6dp"
                android:text="1. Comprobante de domicilio del salón"
                android:textColor="@color/texto_principal"
                android:textSize="16sp"
                android:textStyle="bold" />

            <include
                android:id="@+id/cardComprobanteDomicilio"
                layout="@layout/item_documento_salon" />

            <!-- 2. LICENCIA -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="6dp"
                android:text="2. Licencia de funcionamiento municipal o Vo. Bo."
                android:textColor="@color/texto_principal"
                android:textSize="16sp"
                android:textStyle="bold" />

            <include
                android:id="@+id/cardLicenciaFuncionamiento"
                layout="@layout/item_documento_salon" />

            <!-- 3. CONSTANCIA -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="6dp"
                android:text="3. Constancia de situación fiscal"
                android:textColor="@color/texto_principal"
                android:textSize="16sp"
                android:textStyle="bold" />

            <include
                android:id="@+id/cardConstanciaFiscal"
                layout="@layout/item_documento_salon" />

            <!-- 4. FOTOGRAFÍA -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="6dp"
                android:text="4. Fotografía de la persona propietaria"
                android:textColor="@color/texto_principal"
                android:textSize="16sp"
                android:textStyle="bold" />

            <include
                android:id="@+id/cardFotografiaPersona"
                layout="@layout/item_documento_salon" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- PIE DE PANTALLA -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/header_footer_light"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp">

        <TextView
            android:id="@+id/tvProgresoDocumentos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite"
            android:gravity="center"
            android:text="0 de 4 documentos seleccionados"
            android:textColor="@color/texto_secundario"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEnviarRevision"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:enabled="false"
            android:minHeight="48dp"
            android:text="Enviar a revisión"
            android:textAllCaps="false"
            app:cornerRadius="12dp" />
    </LinearLayout>

</LinearLayout>