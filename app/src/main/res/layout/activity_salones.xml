<?xml version="1.0" encoding="utf-8"?>

<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_general">

    <!-- CONTENIDO -->

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingBottom="90dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- ENCABEZADO -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvSalonCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mis salones"
                        android:textColor="@color/texto_principal"
                        android:textSize="27sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="Administra los espacios que tienes publicados."
                        android:textColor="@color/texto_secundario"
                        android:textSize="13sp" />

                </LinearLayout>

                <!-- CONTADOR -->

                <TextView
                    android:id="@+id/tvSalonNumber"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:gravity="center"
                    android:text="0"
                    android:textColor="@color/texto_principal"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_circle_yellow" />

            </LinearLayout>


            <!-- BOTÓN NUEVO SALÓN -->

            <LinearLayout
                android:id="@+id/btnNuevoSalon"
                android:layout_width="match_parent"
                android:layout_height="65dp"
                android:layout_marginTop="20dp"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:background="@drawable/bg_owner_card"
                android:elevation="3dp"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:gravity="center"
                    android:text="+"
                    android:textColor="@color/texto_principal"
                    android:textSize="25sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_circle_yellow" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="13dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Agregar nuevo salón"
                        android:textColor="@color/texto_principal"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Registra un nuevo espacio"
                        android:textColor="@color/texto_secundario"
                        android:textSize="12sp" />

                </LinearLayout>

                <TextView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:gravity="center"
                    android:text="›"
                    android:textColor="@color/texto_secundario"
                    android:textSize="25sp" />

            </LinearLayout>


            <!-- TÍTULO LISTA -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:text="Espacios registrados"
                android:textColor="@color/texto_principal"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Consulta y administra tus salones."
                android:textColor="@color/texto_secundario"
                android:textSize="12sp" />


            <!-- CONTENEDOR DE SALONES -->

            <LinearLayout
                android:id="@+id/containerSalones"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical" />


            <!-- SIN SALONES -->

            <LinearLayout
                android:id="@+id/layoutEmptySalones"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="45dp"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:gravity="center"
                    android:text="🏢"
                    android:textSize="34sp"
                    android:background="@drawable/bg_circle_yellow" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:text="No tienes salones registrados"
                    android:textColor="@color/texto_principal"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Agrega tu primer salón para comenzar."
                    android:textColor="@color/texto_secundario"
                    android:textSize="12sp" />

            </LinearLayout>


            <!-- ESPACIO PARA EL MENÚ -->

            <Space
                android:layout_width="match_parent"
                android:layout_height="90dp" />


        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- BOTÓN FLOTANTE -->

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAddSalon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="88dp"
        android:contentDescription="Agregar salón"
        android:src="@android:drawable/ic_input_add"
        android:tint="@color/blanco"
        android:backgroundTint="@color/rojo_error"
        android:elevation="6dp" />

    <!-- MENÚ INFERIOR -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@drawable/bg_bottom_menu"
        android:elevation="10dp">

        <include
            layout="@layout/bottom_nav_owner"
            android:layout_width="match_parent"
            android:layout_height="72dp" />

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
