<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_general"
    android:fitsSystemWindows="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="64dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:background="@color/header_footer_light">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVolverDetalle"
            style="@style/BotonOcasionSecundario"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:minWidth="0dp"
            android:padding="0dp"
            android:text="‹"
            android:textSize="26sp"
            android:contentDescription="Volver a explorar salones"
            app:cornerRadius="24dp" />
        <TextView
            style="@style/ClienteTitulo"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:text="Conoce el espacio" />
    </LinearLayout>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingBottom="24dp">
            <LinearLayout
                style="@style/ClienteSeccion">
                <TextView
                    style="@style/ClienteTexto"
                    android:text="UN LUGAR PARA CELEBRAR"
                    android:textSize="11sp"
                    android:textColor="@color/verde_primario"
                    android:layout_marginTop="0dp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/tvNombreDetalle"
                    style="@style/ClienteTitulo"
                    android:textSize="26sp"
                    android:layout_marginTop="8dp" />
                <TextView
                    android:id="@+id/tvIdentificadorSalonDetalle"
                    style="@style/ClienteTexto"
                    android:layout_marginTop="4dp" />
                <TextView
                    android:id="@+id/tvVerificacionDetalle"
                    style="@style/ClienteEtiqueta"
                    android:textStyle="bold"
                    android:visibility="gone" />
                <TextView
                    android:id="@+id/tvResumenDetalle"
                    style="@style/ClienteTexto" />
                <TextView
                    android:id="@+id/tvCapacidadDetalle"
                    style="@style/ClienteEtiqueta" />
                <TextView
                    android:id="@+id/tvPrecioDetalle"
                    style="@style/ClienteTitulo"
                    android:layout_marginTop="12dp"
                    android:textColor="@color/verde_primario" />
            </LinearLayout>
            <TextView
                android:id="@+id/tvEstadoDetalle"
                style="@style/ClienteTexto"
                android:accessibilityLiveRegion="polite" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReintentarDetalle"
                style="@style/BotonOcasionSecundario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Reintentar ficha"
                android:visibility="gone" />
            <HorizontalScrollView
                android:id="@+id/scrollFotosDetalle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:scrollbars="none"
                android:clipToPadding="false"
                android:visibility="gone">
                <LinearLayout
                    android:id="@+id/filaFotosDetalle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>
            <LinearLayout
                android:id="@+id/contenidoDetalle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">
                <LinearLayout
                    style="@style/ClienteSeccion">
                    <TextView
                        style="@style/ClienteTitulo"
                        android:text="Sobre el salón" />
                    <TextView
                        android:id="@+id/tvDescripcionDetalle"
                        style="@style/ClienteTexto" />
                </LinearLayout>
                <LinearLayout
                    style="@style/ClienteSeccion">
                    <TextView
                        style="@style/ClienteTitulo"
                        android:text="Servicios incluidos" />
                    <TextView
                        android:id="@+id/tvServiciosDetalle"
                        style="@style/ClienteTexto"
                        android:lineSpacingExtra="8dp" />
                </LinearLayout>
                <LinearLayout
                    style="@style/ClienteSeccion">
                    <TextView
                        style="@style/ClienteTitulo"
                        android:text="Ubicación" />
                    <TextView
                        android:id="@+id/tvDireccionDetalle"
                        style="@style/ClienteTexto" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnMapsDetalle"
                        style="@style/BotonOcasionSecundario"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Abrir ubicación en el mapa" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                style="@style/ClienteSeccion">
                <TextView
                    style="@style/ClienteTitulo"
                    android:text="¿Cuándo quieres celebrar?" />
                <TextView
                    style="@style/ClienteTexto"
                    android:text="Consulta el calendario antes de planear tu evento. Revisar una fecha no genera una reservación." />
                <include
                    android:id="@+id/tvHorarioHabitualDetalle"
                    layout="@layout/tarjeta_horario_salon"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDisponibilidadDetalle"
                    style="@style/BotonOcasionPrincipal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Consultar disponibilidad" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnIniciarReserva"
                    style="@style/BotonOcasionPrincipal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Iniciar reservación" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/panelCalendarioDetalle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_owner_card"
                android:orientation="vertical"
                android:padding="12dp"
                android:visibility="gone"
                xmlns:android="http://schemas.android.com/apk/res/android">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnMesAnteriorDetalle"
                        style="@style/BotonOcasionSecundario"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:minWidth="0dp"
                        android:padding="0dp"
                        android:contentDescription="Mes anterior"
                        android:text="‹"
                        android:textSize="22sp" />
                    <TextView
                        android:id="@+id/tvMesDetalle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:textColor="@color/texto_principal"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnMesSiguienteDetalle"
                        style="@style/BotonOcasionSecundario"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:minWidth="0dp"
                        android:padding="0dp"
                        android:contentDescription="Mes siguiente"
                        android:text="›"
                        android:textSize="22sp" />
                </LinearLayout>
                <TextView
                    android:id="@+id/tvEstadoCalendarioDetalle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="8dp"
                    android:accessibilityLiveRegion="polite"
                    android:textColor="@color/texto_principal"
                    android:textSize="14sp" />
                <GridLayout
                    android:id="@+id/gridDiasDetalle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="7" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnReintentarCalendarioDetalle"
                    style="@style/BotonOcasionSecundario"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Reintentar carga de disponibilidad"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
