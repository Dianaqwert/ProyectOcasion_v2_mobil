<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_general"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <Button
            android:id="@+id/btnVolverDetalle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="‹ Volver a salones"
            />

        <TextView
            android:id="@+id/tvNombreDetalle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/texto_principal"
            android:textSize="25sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvResumenDetalle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="8dp"
            android:textColor="@color/texto_secundario"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tvEstadoDetalle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite"
            android:textColor="@color/texto_secundario" />

        <Button
            android:id="@+id/btnReintentarDetalle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Reintentar ficha"
            android:visibility="gone" />

        <HorizontalScrollView
            android:id="@+id/scrollFotosDetalle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="8dp"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/filaFotosDetalle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <LinearLayout
            android:id="@+id/contenidoDetalle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvDescripcionDetalle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/texto_principal"
                android:textSize="16sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Servicios incluidos"
                android:textColor="@color/texto_principal"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvServiciosDetalle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/texto_secundario" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Ubicación"
                android:textColor="@color/texto_principal"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDireccionDetalle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/texto_secundario" />

            <Button
                android:id="@+id/btnMapsDetalle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ver en Google Maps" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDisponibilidadDetalle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:backgroundTint="@color/verde_primario"
            android:text="Revisar disponibilidad"
            android:textColor="@color/blanco"
            />

        <LinearLayout
            android:id="@+id/panelCalendarioDetalle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnMesAnteriorDetalle"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="Mes anterior"
                    android:text="‹" />

                <TextView
                    android:id="@+id/tvMesDetalle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:textColor="@color/texto_principal"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnMesSiguienteDetalle"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="Mes siguiente"
                    android:text="›" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvEstadoCalendarioDetalle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="8dp"
                android:accessibilityLiveRegion="polite"
                android:textColor="@color/texto_principal" />

            <GridLayout
                android:id="@+id/gridDiasDetalle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="7" />

            <Button
                android:id="@+id/btnReintentarCalendarioDetalle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Reintentar carga de disponibilidad"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>