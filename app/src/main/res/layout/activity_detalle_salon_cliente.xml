<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/scrollDetalleSalon"
    android:fitsSystemWindows="true"
    android:background="@color/bg_general"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp">

            <TextView
                android:id="@+id/btnBackDetalleSalon"
                android:layout_width="40dp"
                android:layout_height="48dp"
                android:gravity="center"
                android:text="‹"
                android:textColor="@color/texto_principal"
                android:textSize="34sp" />

            <TextView
                android:id="@+id/tvNombreDetalle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Detalle del salón"
                android:textColor="@color/texto_principal"
                android:textSize="19sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ProgressBar android:id="@+id/progressDetalle"
            android:layout_width="36dp" android:layout_height="36dp"
            android:layout_gravity="center" android:visibility="gone" />
        <TextView android:id="@+id/tvErrorDetalle"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:padding="16dp" android:textColor="@color/rojo_error" android:visibility="gone" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btnReintentarDetalle"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="center" android:text="Reintentar detalle"
            android:visibility="gone" app:backgroundTint="@color/verde_primario" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvFotosSalon"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:clipToPadding="false"
            android:paddingHorizontal="16dp"
            android:overScrollMode="never" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="14dp">

            <TextView
                android:id="@+id/tvPrecioDetalle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/verde_primario"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDatosSalon"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/texto_secundario"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRevisarDisponibilidad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Revisar disponibilidad"
                android:textAllCaps="false"
                app:backgroundTint="@color/verde_primario" />

            <TextView
                android:id="@+id/tvDescripcionSalon"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="@color/texto_principal"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="Servicios"
                android:textColor="@color/texto_principal"
                android:textSize="18sp"
                android:textStyle="bold" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipsServiciosDetalle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:chipSpacingHorizontal="8dp"
                app:chipSpacingVertical="4dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="Ubicación"
                android:textColor="@color/texto_principal"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDireccionSalon"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:textColor="@color/texto_secundario"
                android:textSize="14sp" />

            <FrameLayout
                android:id="@+id/mapaDetalleContainer"
                android:layout_width="match_parent"
                android:layout_height="170dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_map_placeholder">

                <WebView
                    android:id="@+id/webViewMapaDetalle"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/bg_general" />
            </FrameLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAbrirMapaSalon"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Ver en Google Maps"
                android:textAllCaps="false"
                app:backgroundTint="@color/naranja_primario" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Disponibilidad"
                    android:textColor="@color/texto_principal"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/btnMesAnterior"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Mes anterior"
                    android:src="@android:drawable/ic_media_previous" />

                <TextView
                    android:id="@+id/tvMesCalendario"
                    android:layout_width="120dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textColor="@color/texto_principal"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/btnMesSiguiente"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Mes siguiente"
                    android:src="@android:drawable/ic_media_next" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Rojo: ocupado o bloqueado · Verde: disponible"
                android:textColor="@color/texto_secundario"
                android:textSize="12sp" />

            <ProgressBar
                android:id="@+id/progressCalendario"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="center"
                android:layout_margin="12dp"
                android:visibility="gone" />

            <GridLayout
                android:id="@+id/gridCalendario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:columnCount="7"
                android:rowCount="7" />

            <TextView android:id="@+id/tvSeleccionDisponibilidad"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:accessibilityLiveRegion="polite"
                android:textColor="@color/texto_principal" />
            <TextView android:id="@+id/tvRangosOcupados"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:textColor="@color/texto_secundario" />
            <TextView
                android:id="@+id/tvErrorCalendario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/rojo_error"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReintentarCalendario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Reintentar carga de disponibilidad"
                android:textAllCaps="false"
                android:visibility="gone"
                app:backgroundTint="@color/naranja_primario" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
