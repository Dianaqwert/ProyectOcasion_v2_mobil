<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_general">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <!-- ENCABEZADO -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/btnBackUbicacion"
                    android:layout_width="45dp"
                    android:layout_height="45dp"
                    android:gravity="center"
                    android:text="‹"
                    android:textColor="@color/texto_principal"
                    android:textSize="34sp"
                    android:clickable="true"
                    android:focusable="true" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="5dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Ubicación"
                        android:textColor="@color/texto_principal"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Indica dónde se encuentra tu salón."
                        android:textColor="@color/texto_secundario"
                        android:textSize="12sp" />

                </LinearLayout>

            </LinearLayout>




            <!-- DIRECCIÓN -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Dirección del salón"
                    android:textColor="@color/texto_principal"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Completa todos los datos de la dirección."
                    android:textColor="@color/texto_secundario"
                    android:textSize="12sp" />


                <!-- CIUDAD -->

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="Ciudad *"
                    android:textColor="@color/texto_principal"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etCiudad"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_edittext"
                    android:hint="Ej. Aguascalientes"
                    android:inputType="textCapSentences"
                    android:paddingHorizontal="14dp"
                    android:textColor="@color/texto_principal"
                    android:textColorHint="@color/texto_secundario" />

                <TextView
                    android:id="@+id/tvErrorCiudad"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/rojo_error"
                    android:textSize="11sp"
                    android:visibility="gone" />


                <!-- CP -->

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Código Postal *"
                    android:textColor="@color/texto_principal"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etCodigoPostal"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_edittext"
                    android:hint="Ej. 20000"
                    android:inputType="number"
                    android:maxLength="5"
                    android:paddingHorizontal="14dp"
                    android:textColor="@color/texto_principal"
                    android:textColorHint="@color/texto_secundario" />

                <TextView
                    android:id="@+id/tvErrorCodigoPostal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/rojo_error"
                    android:textSize="11sp"
                    android:visibility="gone" />


                <!-- CALLE -->

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Calle *"
                    android:textColor="@color/texto_principal"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etCalle"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_edittext"
                    android:hint="Ej. Avenida Universidad"
                    android:inputType="textCapSentences"
                    android:paddingHorizontal="14dp"
                    android:textColor="@color/texto_principal"
                    android:textColorHint="@color/texto_secundario" />

                <TextView
                    android:id="@+id/tvErrorCalle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/rojo_error"
                    android:textSize="11sp"
                    android:visibility="gone" />


                <!-- NUMERO -->

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Número *"
                    android:textColor="@color/texto_principal"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etNumero"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_edittext"
                    android:hint="Ej. 123"
                    android:inputType="text"
                    android:paddingHorizontal="14dp"
                    android:textColor="@color/texto_principal"
                    android:textColorHint="@color/texto_secundario" />

                <TextView
                    android:id="@+id/tvErrorNumero"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/rojo_error"
                    android:textSize="11sp"
                    android:visibility="gone" />


                <!-- FRACCIONAMIENTO -->

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Fraccionamiento *"
                    android:textColor="@color/texto_principal"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etFraccionamiento"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_edittext"
                    android:hint="Ej. Jardines del Valle"
                    android:inputType="textCapSentences"
                    android:paddingHorizontal="14dp"
                    android:textColor="@color/texto_principal"
                    android:textColorHint="@color/texto_secundario" />

                <TextView
                    android:id="@+id/tvErrorFraccionamiento"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/rojo_error"
                    android:textSize="11sp"
                    android:visibility="gone" />

            </LinearLayout>


            <!-- COORDENADAS -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Ubicación geográfica"
                    android:textColor="@color/texto_principal"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Coordenadas utilizadas para mostrar el salón en el mapa."
                    android:textColor="@color/texto_secundario"
                    android:textSize="12sp" />


                <!-- LATITUD -->

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="Latitud *"
                    android:textColor="@color/texto_principal"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etLatitud"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_edittext"
                    android:hint="Ej. 21.8818"
                    android:inputType="numberDecimal|numberSigned"
                    android:paddingHorizontal="14dp"
                    android:textColor="@color/texto_principal"
                    android:textColorHint="@color/texto_secundario" />

                <TextView
                    android:id="@+id/tvErrorLatitud"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/rojo_error"
                    android:textSize="11sp"
                    android:visibility="gone" />


                <!-- LONGITUD -->

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Longitud *"
                    android:textColor="@color/texto_principal"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etLongitud"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_edittext"
                    android:hint="Ej. -102.2916"
                    android:inputType="numberDecimal|numberSigned"
                    android:paddingHorizontal="14dp"
                    android:textColor="@color/texto_principal"
                    android:textColorHint="@color/texto_secundario" />

                <TextView
                    android:id="@+id/tvErrorLongitud"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/rojo_error"
                    android:textSize="11sp"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMostrarUbicacion"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="16dp"
                    android:text="Mostrar ubicación en el mapa"
                    android:textAllCaps="false"
                    android:textColor="@color/blanco"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:backgroundTint="@color/naranja_primario"
                    android:background="@drawable/bg_icon_circle"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <!-- FILA: ÍCONO + TEXTOS -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <!-- ÍCONO -->
                        <TextView
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:background="@drawable/bg_icon_circle"
                            android:gravity="center"
                            android:text="📍"
                            android:textSize="21sp" />

                        <!-- CONTENEDOR DE TEXTOS -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Vista previa de ubicación"
                                android:textColor="@color/texto_principal"
                                android:textSize="18sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:text="La ubicación se mostrará en el mapa utilizando las coordenadas."
                                android:textColor="@color/texto_secundario"
                                android:textSize="12sp" />

                        </LinearLayout>

                    </LinearLayout>


                    <!-- MAPA -->
                    <FrameLayout
                        android:id="@+id/mapPreviewContainer"
                        android:layout_width="match_parent"
                        android:layout_height="220dp"
                        android:layout_marginTop="15dp"
                        android:background="@drawable/bg_edittext">

                        <!-- Aquí posteriormente se integrará Google Maps -->

                        <TextView
                            android:id="@+id/tvMapaPlaceholder"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:text="Vista previa del mapa&#10;Ingresa latitud y longitud"
                            android:textAlignment="center"
                            android:textColor="@color/texto_secundario"
                            android:textSize="14sp" />

                    </FrameLayout>

                </LinearLayout>

            </LinearLayout>


            <!-- CONTINUAR -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnContinuarPublicacion"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="20dp"
                android:text="Continuar"
                android:textAllCaps="false"
                android:textColor="@color/blanco"
                android:textSize="15sp"
                android:textStyle="bold"
                android:background="@drawable/bg_button_secondary"
                android:backgroundTint="@color/naranja_primario" />

        </LinearLayout>


    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@drawable/bg_bottom_menu"
        android:elevation="10dp">

        <include
            layout="@layout/bottom_nav_owner"
            android:layout_width="match_parent"
            android:layout_height="72dp" />
    </LinearLayout>

</LinearLayout>