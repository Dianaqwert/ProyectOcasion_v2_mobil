<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Permite tráfico HTTP (sin cifrar) SOLO hacia la IP de tu servidor por VPN.
         El resto de la app sigue exigiendo HTTPS normalmente.
         Si la IP del servidor cambia, actualízala aquí también. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">172.30.209.58</domain>
    </domain-config>
</network-security-config>
